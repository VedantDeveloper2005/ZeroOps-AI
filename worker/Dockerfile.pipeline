FROM --platform=linux/amd64 mcr.microsoft.com/azure-cli:2.87.0-azurelinux3.0@sha256:ae2b53ff3933260ebfd0b1fd0e58650ceb6233bdc7a8f20cef1bea9ebb72dc7e

ARG TERRAFORM_VERSION=1.15.8
ARG TERRAFORM_SHA256=d25ce7b6902013ad905db3d2eab0be4cd905887fe88b81a6171b8d5503c31f3d
ARG TFLINT_VERSION=0.64.0
ARG TFLINT_SHA256=cca9d13e2e1d7a2c627af60ff899a3c9b74212899416aeb96ec764d2ef954537
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
ARG TRIVY_VERSION=0.73.0
ARG TRIVY_SHA256=2edd39da482bb4e9831962487b68f68e3928ec3137794757f54d00383d79547b
ARG KUBECONFORM_VERSION=0.8.0
ARG KUBECONFORM_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
ARG SYFT_VERSION=1.50.0
ARG SYFT_SHA256=bf7b29ff57f06da30918266a0e1c2885a8f99784798d1bdb1628886aa015d788
ARG HELM_VERSION=3.19.0
ARG HELM_SHA256=a7f81ce08007091b86d8bd696eb4d86b8d0f2e1b9f6c714be62f82f96a594496
ARG KUBECTL_VERSION=1.34.1
ARG KUBECTL_SHA256=7721f265e18709862655affba5343e85e1980639395d5754473dafaadcaa69e3

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH="/opt/zeroops/bin:/usr/local/bin:${PATH}" \
    TF_IN_AUTOMATION=true \
    CHECKPOINT_DISABLE=1 \
    SEMGREP_SEND_METRICS=off \
    NO_COLOR=1

RUN tdnf update -y \
    && tdnf install -y ca-certificates curl git gzip nodejs npm python3 python3-pip shadow-utils tar unzip \
    && tdnf clean all

RUN curl --fail --show-error --silent --location \
      "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip" \
      --output /tmp/terraform.zip \
    && echo "${TERRAFORM_SHA256}  /tmp/terraform.zip" | sha256sum --check --strict \
    && unzip -q /tmp/terraform.zip -d /usr/local/bin \
    && rm -f /tmp/terraform.zip \
    && terraform version

RUN curl --fail --show-error --silent --location \
      "https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}/tflint_linux_amd64.zip" \
      --output /tmp/tflint.zip \
    && echo "${TFLINT_SHA256}  /tmp/tflint.zip" | sha256sum --check --strict \
    && unzip -q /tmp/tflint.zip -d /usr/local/bin \
    && rm -f /tmp/tflint.zip \
    && tflint --version

RUN curl --fail --show-error --silent --location \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      --output /tmp/gitleaks.tar.gz \
    && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm -f /tmp/gitleaks.tar.gz \
    && gitleaks version

RUN curl --fail --show-error --silent --location \
      "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
      --output /tmp/trivy.tar.gz \
    && echo "${TRIVY_SHA256}  /tmp/trivy.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/trivy.tar.gz -C /usr/local/bin trivy \
    && rm -f /tmp/trivy.tar.gz \
    && trivy --version

RUN curl --fail --show-error --silent --location \
      "https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz" \
      --output /tmp/kubeconform.tar.gz \
    && echo "${KUBECONFORM_SHA256}  /tmp/kubeconform.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/kubeconform.tar.gz -C /usr/local/bin kubeconform \
    && rm -f /tmp/kubeconform.tar.gz \
    && kubeconform -v

RUN curl --fail --show-error --silent --location \
      "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" \
      --output /tmp/syft.tar.gz \
    && echo "${SYFT_SHA256}  /tmp/syft.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/syft.tar.gz -C /usr/local/bin syft \
    && rm -f /tmp/syft.tar.gz \
    && syft version

RUN curl --fail --show-error --silent --location \
      "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
      --output /tmp/helm.tar.gz \
    && echo "${HELM_SHA256}  /tmp/helm.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/helm.tar.gz -C /tmp \
    && install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tar.gz /tmp/linux-amd64 \
    && helm version --short

RUN curl --fail --show-error --silent --location \
      "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
      --output /tmp/kubectl \
    && echo "${KUBECTL_SHA256}  /tmp/kubectl" | sha256sum --check --strict \
    && install -m 0755 /tmp/kubectl /usr/local/bin/kubectl \
    && rm -f /tmp/kubectl \
    && kubectl version --client=true

COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN python3 -m venv /opt/zeroops \
    && /opt/zeroops/bin/python -m pip install --no-cache-dir --upgrade pip \
    && /opt/zeroops/bin/python -m pip install --no-cache-dir \
      --requirement /tmp/backend-requirements.txt \
      checkov==3.3.8 \
      semgrep==1.164.0 \
    && rm -f /tmp/backend-requirements.txt \
    && /opt/zeroops/bin/python -m pip check \
    && semgrep --version

RUN useradd --create-home --uid 10001 --shell /sbin/nologin zeroops \
    && install -d -o root -g root -m 0755 /app \
    && install -d -o zeroops -g zeroops -m 0700 /work

WORKDIR /app
COPY --chown=root:root backend /app/backend
COPY --chown=root:root worker /app/worker
COPY --chown=root:root ai-specs /app/ai-specs
RUN chmod -R a-w /app \
    && install -d -o zeroops -g zeroops -m 0700 /app/backend/workspace

USER zeroops
EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8085/ready', timeout=3)"

CMD ["python", "-m", "worker.main"]
