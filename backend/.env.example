# FastAPI App Service
APP_ENV=production
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=180

# CORS: set to the frontend App Service origin.
# Example: https://zeroops-web.azurewebsites.net
FRONTEND_ORIGIN=
CORS_ORIGINS=

# Optional integrations. Missing values disable the related integration.
OPENAI_API_KEY=
GITHUB_TOKEN=
AZURE_KEYVAULT_URL=

# GKE deployment targets are saved per user in Settings -> Cloud Targets.
# Install docker, kubectl, and gcloud on the deployment worker.

# GitHub OAuth App (create at https://github.com/settings/developers)
# Callback URL: https://<backend-domain>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend URL for OAuth callback redirect
# Example: https://zeroops-web.azurewebsites.net
FRONTEND_URL=

# Database & authentication secrets
DATABASE_URL=
JWT_SECRET=

# Optional metadata for docs and frontend config.
ZEROOPS_BACKEND_URL=
