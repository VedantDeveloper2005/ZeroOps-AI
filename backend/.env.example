# Non-secret runtime settings (configure as Container App/App Service settings)
APP_ENV=production
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=180
FRONTEND_URL=https://<your-zeroops-web-domain>
CORS_ORIGINS=https://<your-zeroops-web-domain>
ALLOWED_HOSTS=<your-zeroops-api-domain>
ZEROOPS_BACKEND_URL=https://<your-zeroops-api-domain>
AZURE_KEYVAULT_URL=https://<your-key-vault>.vault.azure.net/
AZURE_DEFAULT_REGION=<your-azure-region>
MAX_CODE_UPLOAD_MB=50
MAX_UPLOAD_ARCHIVE_FILES=10000
MAX_UPLOAD_UNCOMPRESSED_MB=250
MAX_UPLOAD_COMPRESSION_RATIO=100
MAX_RATE_LIMIT_KEYS=10000
DB_SSL_VERIFY=true

# Key Vault-backed settings (inject as secret references; do not create .env in production)
DATABASE_URL=<postgresql-connection-string>
JWT_SECRET=<64-or-more-random-characters>
GITHUB_CLIENT_ID=<github-oauth-client-id>
GITHUB_CLIENT_SECRET=<github-oauth-client-secret>

# Only add these when the related paid integration is enabled.
# OPENAI_API_KEY=<provider-api-key>
# OPENAI_MODEL=gpt-5.4-mini
# AI_MODEL_TIMEOUT_SECONDS=30
# GITHUB_TOKEN=<server-side-github-token-if-oauth-is-not-enough>
# STRIPE_SECRET_KEY=<stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>

# SMTP settings for email verification & Email MFA (e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24
EMAIL_OTP_EXPIRE_MINUTES=10

# Azure hosting is configured per customer in Settings -> Hosting.
# The customer's service-principal secret is stored dynamically in Key Vault;
# never put a customer secret in this file or the database.
