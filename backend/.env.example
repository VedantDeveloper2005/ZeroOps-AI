# The control plane reads every application setting directly from Azure Key
# Vault. These two non-secret settings are the minimum bootstrap required by
# App Service, Container Apps, and the isolated worker.
APP_ENV=production
AZURE_KEYVAULT_URL=https://<your-key-vault>.vault.azure.net/

# Optional only when using a user-assigned managed identity. Do not set a
# client secret; DefaultAzureCredential authenticates with the managed identity.
# AZURE_CLIENT_ID=<managed-identity-client-id>

# Keep this file value-only for bootstrap. All application settings, including
# PORT, FRONTEND_URL, DATABASE_URL, JWT_SECRET, SMTP, OAuth, AI, Stripe,
# Twilio, worker callbacks, and operational limits belong in Key Vault.
# See ../docs/production-key-vault.md for the naming convention and setup.

# Microsoft Foundry workload settings (stored in Key Vault in production).
# AI_REPOSITORY_PROVIDER=azure-openai
# AI_REPOSITORY_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# AI_REPOSITORY_MODEL=<deployment-name>
# AI_REPOSITORY_API_KEY=<workload-secret>
# AI_TERRAFORM_PROVIDER=azure-openai
# AI_TERRAFORM_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
# AI_TERRAFORM_MODEL=<deployment-name>
# AI_TERRAFORM_API_KEY=<workload-secret>

# Microsoft Foundry Architecture Advisor (DefaultAzureCredential / az login / Managed Identity)
# FOUNDRY_PROJECT_ENDPOINT=https://zeroops-aitest-resource.services.ai.azure.com/api/projects/zeroops-aitest
# FOUNDRY_AGENT_NAME=zeroops-architecture-advisor
# FOUNDRY_AGENT_VERSION=2
# FOUNDRY_REQUEST_TIMEOUT_SECONDS=120

