# The control plane reads every application setting directly from Azure Key
# Vault. These two non-secret settings are the minimum bootstrap required by
# App Service, Container Apps, and the isolated worker.
APP_ENV=production
AZURE_KEYVAULT_URL=https://<your-key-vault>.vault.azure.net/

# Optional only when using a user-assigned managed identity. Do not set a
# client secret; DefaultAzureCredential authenticates with the managed identity.
# AZURE_CLIENT_ID=<managed-identity-client-id>

# Keep this file value-only for bootstrap. All application settings, including
# PORT, FRONTEND_URL, DATABASE_URL, JWT_SECRET, SMTP, OAuth, AI, Stripe,
# Twilio, worker callbacks, and operational limits belong in Key Vault.
# See ../docs/production-key-vault.md for the naming convention and setup.
