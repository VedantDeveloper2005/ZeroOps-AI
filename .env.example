# Frontend build settings. These values are public and become part of the
# browser bundle; they must never contain a credential or connection string.
NODE_ENV=production
DEPLOYMENT_VERSION=zeroops-prod-001
NEXT_PUBLIC_API_BASE_URL=https://<your-zeroops-api-domain>
# Optional. When omitted, the browser derives wss:// from NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_WS_BASE_URL=
# Used by Next.js rewrites during the frontend build. Keep it equal to the API URL.
ZEROOPS_BACKEND_URL=https://<your-zeroops-api-domain>

# Backend/worker Key Vault bootstrap. APP_ENV selects fail-closed startup and
# AZURE_KEYVAULT_URL tells DefaultAzureCredential where to fetch all application
# values. Do not add DATABASE_URL, JWT_SECRET, SMTP, OAuth, Stripe, AI, or
# Twilio values to this file.
APP_ENV=production
AZURE_KEYVAULT_URL=https://<your-key-vault>.vault.azure.net/
# Set only for a user-assigned managed identity.
# AZURE_CLIENT_ID=<managed-identity-client-id>

# See docs/production-key-vault.md for the required Key Vault entries.
