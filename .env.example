# Frontend App Service
NODE_ENV=production
DEPLOYMENT_VERSION=zeroops-prod-001

# Backend App Service base URL used by Next.js rewrites.
# Example: https://zeroops-api.azurewebsites.net
ZEROOPS_BACKEND_URL=

# Browser-visible backend URLs for websocket connections.
# Use wss:// for NEXT_PUBLIC_WS_BASE_URL in production.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=

# Backend App Service
APP_ENV=production
FRONTEND_URL=
FRONTEND_ORIGIN=
CORS_ORIGINS=
DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA (generate MFA_ENCRYPTION_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# A separate key is strongly recommended for production; when omitted the backend
# derives a compatibility key from JWT_SECRET.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=ZeroOps AI

# Transactional email. Production startup fails closed when these are missing,
# because local accounts must receive a real verification link.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Local-account phone verification through Twilio. Use E.164 numbers, e.g.
# +14155552671. SMS proves phone ownership at enrollment; enable TOTP MFA in
# the profile for the strongest sign-in protection.
PHONE_VERIFICATION_REQUIRED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_OTP_EXPIRE_MINUTES=5
PHONE_OTP_LENGTH=6
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo,read:user,user:email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid email profile

# AI Providers
OPENAI_API_KEY=
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o
NVIDIA_API_KEY=

# Azure user deployment defaults
AZURE_DEFAULT_REGION=eastus
AZURE_KEYVAULT_URL=
ZEROOPS_PUBLIC_BASE_DOMAIN=
MAX_CODE_UPLOAD_MB=50

# GKE deployment targets are saved per user in Settings -> Cloud Targets.
# The backend worker image/host must include docker, kubectl, and gcloud.

# Paid AI operation controls
PAYMENT_PROVIDER=manual
AI_PAID_OPERATION_PRICE_CENTS=499
AI_FREE_DAILY_LIMIT=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
