# Frontend App Service
NODE_ENV=production
DEPLOYMENT_VERSION=zeroops-prod-001

# Backend App Service base URL used by Next.js rewrites.
# Example: https://zeroops-api.azurewebsites.net
ZEROOPS_BACKEND_URL=

# Browser-visible backend URLs for websocket connections.
# Use wss:// for NEXT_PUBLIC_WS_BASE_URL in production.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_WS_BASE_URL=

# Backend App Service
APP_ENV=production
FRONTEND_URL=
FRONTEND_ORIGIN=
CORS_ORIGINS=
DATABASE_URL=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=repo,read:user,user:email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid email profile

# AI Providers
OPENAI_API_KEY=
GITHUB_MODELS_API_KEY=
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o
NVIDIA_API_KEY=

# Azure user deployment defaults
AZURE_DEFAULT_REGION=eastus
AZURE_KEYVAULT_URL=
ZEROOPS_PUBLIC_BASE_DOMAIN=
MAX_CODE_UPLOAD_MB=50

# Paid AI operation controls
PAYMENT_PROVIDER=manual
AI_PAID_OPERATION_PRICE_CENTS=499
AI_FREE_DAILY_LIMIT=5
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
