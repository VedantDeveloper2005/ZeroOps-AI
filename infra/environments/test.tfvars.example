# Test profile: low idle cost, public PaaS endpoints with Entra authentication,
# FC1 functions, Basic ACR, and a regular VMSS that scales from zero to one.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

environment  = "test"
name_suffix = "2f871a"
location     = "centralindia"

enable_private_endpoints = false
service_bus_sku          = "Standard"
service_bus_capacity     = 1

artifact_storage_redundancy = "ZRS"
state_storage_redundancy    = "ZRS"
host_storage_redundancy     = "LRS"
artifact_retention_days     = 30
audit_log_retention_days    = 30

analysis_function_max_instances  = 2
terraform_function_max_instances = 2
history_function_max_instances   = 2
function_instance_memory_mb       = 2048

vmss_sku           = "Standard_B2as_v2"
vmss_zones         = ["1", "2"]
vmss_max_instances = 1
deploy_runner       = false
runner_os_image_version = "22.04.202608060"

# Foundation deployment intentionally creates the ACR without a VMSS. For the
# runner stage, set deploy_runner=true and replace these values with a real key
# and the digest returned by the publish workflow.
runner_admin_ssh_public_key = "ssh-ed25519 AAAAREPLACEWITHAREALPUBLICKEY zeroops-test"
runner_image_reference      = null

# Object ID of the apply UAMI created by infra/bootstrap. This is not a secret.
deployment_identity_principal_id = null

# Assigning Contributor is opt-in and must target a dedicated customer workload
# resource group, never zeroops-rg or a subscription.
execution_scope_resource_id = null

budget_enabled       = false
budget_amount        = 0
budget_start_date    = null
budget_end_date      = null
alert_email_receivers = {}

tags = {
  cost-center = "zeroops-test"
  owner       = "platform-engineering"
}
